# Copy this file to %LOCALAPPDATA%\F.R.I.D.A.Y\server.env on Windows.
# Provider secrets belong only in that host-side file, never in Android or source control.
FRIDAY_AI_PROVIDER=openai_compatible
FRIDAY_AI_BASE_URL=https://api.openai.com/v1
FRIDAY_AI_MODEL=
FRIDAY_AI_API_KEY=
FRIDAY_AI_TIMEOUT_SECONDS=30

# Leave empty to generate a random token in the protected user config directory.
# If you supply one, use at least 32 random characters and keep it private.
FRIDAY_SERVER_TOKEN=

FRIDAY_HOST=0.0.0.0
FRIDAY_PORT=8765
